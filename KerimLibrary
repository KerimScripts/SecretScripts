-- ============================================
-- BIND (Keybind)
-- ============================================
local function createBind(option, parent)
    local binding = false
    local text = string.match(option.key, "Mouse") and string.sub(option.key, 1, 5) .. string.sub(option.key, 12, 13) or option.key
    
    local main = library:Create("TextLabel", {
        LayoutOrder = option.position,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
        Text = " " .. option.text,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        TextColor3 = Colors.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parent.content
    })
    
    local bg = library:Create("Frame", {
        Position = UDim2.new(1, -58, 0.5, -14),
        Size = UDim2.new(0, 52, 0, 28),
        BackgroundColor3 = Colors.BackgroundLight,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Parent = main
    })
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 6)
    bgCorner.Parent = bg
    
    local keyLabel = library:Create("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextColor3 = Colors.Text,
        Parent = bg
    })
    
    main.InputBegan:connect(function(input)
        if input.UserInputType == ui or input.UserInputType == Enum.UserInputType.Touch then
            binding = true
            keyLabel.Text = "..."
            tweenService:Create(bg, TweenInfo.new(0.2), {
                BackgroundColor3 = Colors.Accent,
                BackgroundTransparency = 0.2
            }):Play()
        end
    end)
    
    inputService.InputBegan:connect(function(input)
        if inputService:GetFocusedTextBox() then return end
        if binding then
            local key = input.KeyCode.Name or input.UserInputType.Name
            if key ~= "MouseMovement" then
                option:SetKey(key)
            end
        end
    end)
    
    function option:SetKey(key)
        binding = false
        self.key = key
        library.flags[self.flag] = key
        keyLabel.Text = key
        tweenService:Create(bg, TweenInfo.new(0.2), {
            BackgroundColor3 = Colors.BackgroundLight,
            BackgroundTransparency = 0.3
        }):Play()
        if self.callback then
            self.callback(key)
        end
    end
end

