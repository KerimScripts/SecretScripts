-- ============================================
-- BUTTON (FIXED - Gri Kalma Sorunu Çözüldü)
-- ============================================
local function createButton(option, parent)
    local main = library:Create("TextLabel", {
        ZIndex = 2,
        LayoutOrder = option.position,
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
        Text = " " .. option.text,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        TextColor3 = Colors.Text,
        Parent = parent.content
    })
    
    local bg = library:Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, -12, 1, -8),
        BackgroundColor3 = Colors.BackgroundLight,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Parent = main
    })
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = bg
    
    -- Hover ve Click durumları için değişkenler
    local isHovering = false
    local isClicking = false
    
    local function UpdateButtonAppearance()
        if isClicking then
            tweenService:Create(bg, TweenInfo.new(0.1), {
                BackgroundColor3 = Colors.Accent,
                BackgroundTransparency = 0.1
            }):Play()
        elseif isHovering then
            tweenService:Create(bg, TweenInfo.new(0.1), {
                BackgroundColor3 = Color3.fromRGB(40, 40, 50),
                BackgroundTransparency = 0.2
            }):Play()
        else
            tweenService:Create(bg, TweenInfo.new(0.1), {
                BackgroundColor3 = Colors.BackgroundLight,
                BackgroundTransparency = 0.3
            }):Play()
        end
    end
    
    main.InputBegan:connect(function(input)
        if input.UserInputType == ui or input.UserInputType == Enum.UserInputType.Touch then
            isClicking = true
            UpdateButtonAppearance()
            option.callback()
            task.wait(0.15)
            isClicking = false
            UpdateButtonAppearance()
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            isHovering = true
            UpdateButtonAppearance()
        end
    end)
    
    main.InputEnded:connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            isHovering = false
            if not isClicking then
                UpdateButtonAppearance()
            end
        end
        if input.UserInputType == ui or input.UserInputType == Enum.UserInputType.Touch then
            isClicking = false
            UpdateButtonAppearance()
        end
    end)
end

