local function createList(option, parent)
    local valueCount = 0
    local isOpen = false
    
    local main = library:Create("Frame", {
        LayoutOrder = option.position,
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        Parent = parent.content
    })
    
    local bg = library:Create("Frame", {
        Position = UDim2.new(0, 6, 0, 4),
        Size = UDim2.new(1, -12, 1, -8),
        BackgroundColor3 = Colors.BackgroundLight,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Parent = main
    })
    local bgCorner = Instance.new("UICorner")
    bgCorner.CornerRadius = UDim.new(0, 8)
    bgCorner.Parent = bg
    
    local title = library:Create("TextLabel", {
        Position = UDim2.new(0, 12, 0, 4),
        Size = UDim2.new(1, -24, 0, 16),
        BackgroundTransparency = 1,
        Text = option.text,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextColor3 = Colors.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = main
    })
    
    local valueLabel = library:Create("TextLabel", {
        Position = UDim2.new(0, 12, 0, 20),
        Size = UDim2.new(0.7, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = option.value,
        TextSize = 15,
        Font = Enum.Font.GothamMedium,
        TextColor3 = Colors.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = main
    })
    
    local arrow = library:Create("TextLabel", {
        Position = UDim2.new(1, -20, 0.5, -8),
        Size = UDim2.new(0, 14, 0, 14),
        BackgroundTransparency = 1,
        Text = "▼",
        TextSize = 12,
        TextColor3 = Colors.TextDim,
        Font = Enum.Font.GothamBold,
        Parent = bg
    })
    
    option.mainHolder = library:Create("Frame", {
        ZIndex = 10,
        Size = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = Colors.Background,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Visible = false,
        ClipsDescendants = true,
        Parent = library.base
    })
    local holderCorner = Instance.new("UICorner")
    holderCorner.CornerRadius = UDim.new(0, 8)
    holderCorner.Parent = option.mainHolder
    
    local content = library:Create("ScrollingFrame", {
        ZIndex = 10,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarImageColor3 = Color3.fromRGB(80, 80, 90),
        ScrollBarThickness = 6,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = option.mainHolder
    })
    
    local layout = library:Create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = content
    })
    
    layout.Changed:connect(function()
        local totalHeight = layout.AbsoluteContentSize.Y
        if totalHeight > 0 then
            local height = math.min(totalHeight + 8, 150)
            option.mainHolder.Size = UDim2.new(0, 200, 0, height)
            content.CanvasSize = UDim2.new(0, 0, 0, totalHeight + 8)
        end
    end)
    
    local function ToggleDropdown()
        isOpen = not isOpen
        
        if isOpen then
            local pos = main.AbsolutePosition
            option.mainHolder.Position = UDim2.new(0, pos.X + 6, 0, pos.Y + 48)
            option.mainHolder.Visible = true
            option.mainHolder.Size = UDim2.new(0, 200, 0, 0)
            
            task.wait(0.05)
            local totalHeight = layout.AbsoluteContentSize.Y
            local height = math.min(totalHeight + 8, 150)
            option.mainHolder:TweenSize(UDim2.new(0, 200, 0, height), "Out", "Quad", 0.2, true)
            arrow.Text = "▲"
            library.activePopup = option
        else
            option.mainHolder:TweenSize(UDim2.new(0, 200, 0, 0), "Out", "Quad", 0.2, true)
            arrow.Text = "▼"
            task.wait(0.25)
            option.mainHolder.Visible = false
            library.activePopup = nil
        end
    end
    
    bg.InputBegan:connect(function(input)
        if input.UserInputType == ui or input.UserInputType == Enum.UserInputType.Touch then
            ToggleDropdown()
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            tweenService:Create(bg, TweenInfo.new(0.1), {
                BackgroundColor3 = Color3.fromRGB(40, 40, 50),
                BackgroundTransparency = 0.2
            }):Play()
        end
    end)
    
    bg.InputEnded:connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            tweenService:Create(bg, TweenInfo.new(0.1), {
                BackgroundColor3 = Colors.BackgroundLight,
                BackgroundTransparency = 0.3
            }):Play()
        end
    end)
    
    function option:AddValue(value)
        valueCount = valueCount + 1
        local label = library:Create("TextLabel", {
            ZIndex = 10,
            LayoutOrder = valueCount,
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundTransparency = 1,
            Text = "    " .. tostring(value),
            TextSize = 14,
            Font = Enum.Font.Gotham,
            TextColor3 = Colors.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = content
        })
        
        label.InputBegan:connect(function(input)
            if input.UserInputType == ui or input.UserInputType == Enum.UserInputType.Touch then
                self:SetValue(value)
                ToggleDropdown()
            end
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                tweenService:Create(label, TweenInfo.new(0.1), {
                    BackgroundColor3 = Colors.BackgroundLight,
                    BackgroundTransparency = 0.2
                }):Play()
            end
        end)
        label.InputEnded:connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                tweenService:Create(label, TweenInfo.new(0.1), {
                    BackgroundColor3 = Colors.Background,
                    BackgroundTransparency = 0
                }):Play()
            end
        end)
    end
    
    if option.values then
        for _, value in next, option.values do
            option:AddValue(tostring(value))
        end
    end
    
    function option:SetValue(value)
        library.flags[self.flag] = tostring(value)
        self.value = tostring(value)
        valueLabel.Text = self.value
        if self.callback then
            self.callback(value)
        end
    end
    
    function option:Close()
        if isOpen then
            ToggleDropdown()
        end
    end
end

